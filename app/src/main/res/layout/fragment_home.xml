<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp"
        app:elevation="0dp">

        <!-- Toolbar - white, with hamburger icon and title -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:navigationIcon="@drawable/ic_menu"
            app:title="@string/home_title"
            app:titleTextColor="@color/black"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:menu="@menu/menu_home" />

        <!-- Offline Banner -->
        <LinearLayout
            android:id="@+id/offlineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/offline_orange"
            android:padding="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_offline"
                android:contentDescription="@string/cd_offline"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_message"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Category Tabs - horizontal scrollable text tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/white"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="0dp">

                <!-- Popular Tab (selected by default) -->
                <LinearLayout
                    android:id="@+id/tabPopular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvTabPopular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_popular"
                        android:textSize="@dimen/text_size_tab"
                        android:textColor="@color/tab_selected"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <View
                        android:id="@+id/indicatorPopular"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/tab_indicator" />
                </LinearLayout>

                <!-- All Tab -->
                <LinearLayout
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvTabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_all"
                        android:textSize="@dimen/text_size_tab"
                        android:textColor="@color/tab_unselected"
                        android:paddingBottom="8dp" />

                    <View
                        android:id="@+id/indicatorAll"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Politics Tab -->
                <LinearLayout
                    android:id="@+id/tabPolitics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvTabPolitics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_politics"
                        android:textSize="@dimen/text_size_tab"
                        android:textColor="@color/tab_unselected"
                        android:paddingBottom="8dp" />

                    <View
                        android:id="@+id/indicatorPolitics"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Tech Tab -->
                <LinearLayout
                    android:id="@+id/tabTechnology"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvTabTechnology"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_technology"
                        android:textSize="@dimen/text_size_tab"
                        android:textColor="@color/tab_unselected"
                        android:paddingBottom="8dp" />

                    <View
                        android:id="@+id/indicatorTechnology"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Health Tab -->
                <LinearLayout
                    android:id="@+id/tabHealth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvTabHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_health"
                        android:textSize="@dimen/text_size_tab"
                        android:textColor="@color/tab_unselected"
                        android:paddingBottom="8dp" />

                    <View
                        android:id="@+id/indicatorHealth"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Science Tab -->
                <LinearLayout
                    android:id="@+id/tabScience"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvTabScience"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_science"
                        android:textSize="@dimen/text_size_tab"
                        android:textColor="@color/tab_unselected"
                        android:paddingBottom="8dp" />

                    <View
                        android:id="@+id/indicatorScience"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Thin separator line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_light" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content with SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="12dp" />

            <!-- Loading Progress -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/tab_indicator" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/padding_large"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emoji_news"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_articles_found"
                    android:textSize="@dimen/text_size_large"
                    android:textColor="@color/gray_dark"
                    android:layout_marginTop="@dimen/margin_medium" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_connect_internet"
                    android:textSize="@dimen/text_size_medium"
                    android:textColor="@color/gray_medium"
                    android:textAlignment="center"
                    android:layout_marginTop="@dimen/margin_small"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>